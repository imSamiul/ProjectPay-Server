meta {
  name: Create admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/create
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Platform Admin",
    "email": "{{adminEmail}}",
    "phone": "+8801700000000",
    "password": "{{adminPassword}}"
  }
}

docs {
  # POST /api/v1/admin/create

  Creates a new admin account.

  ## Bootstrap Behavior
  - If no admin exists in the database, this request works **without authentication** to initialize the platform.
  - If an admin already exists, this endpoint requires an **authenticated admin** (`auth` token).

  Automatically captures the returned JWT `token` into the environment upon creation.

  ## Example response `201`
  ```json
  {
    "user": {
      "_id": "66f0...",
      "name": "Platform Admin",
      "email": "admin@test.com",
      "phone": "+8801700000000",
      "userType": "admin"
    },
    "token": "eyJhbGci..."
  }
  ```
}

script:post-response {
  if (res.status === 201 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
  if (res.status === 201 && res.body.user && res.body.user._id) {
    bru.setEnvVar("userId", res.body.user._id);
  }
}

assert {
  res.status: eq 201
}
