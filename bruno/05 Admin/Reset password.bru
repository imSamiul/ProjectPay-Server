meta {
  name: Reset password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/users/{{userId}}/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "newSecretPassword123"
  }
}

docs {
  # POST /api/v1/admin/users/:userId/reset-password

  Directly resets the target user's password without needing the current password.
  Requires `userType: "admin"`.
  Invalidates existing tokens for that user to require fresh login.

  ## Example response `200`
  ```json
  {
    "message": "Password reset successfully. Please log in with the new password.",
    "userId": "66f0..."
  }
  ```
}

assert {
  res.status: eq 200
}
